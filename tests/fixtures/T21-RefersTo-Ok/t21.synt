# T21.SYNT — REFERS TO + ON BIBLIOGRAPHY (Etapa 2a).
# lattes_id referencia a entidade externa "researcher" e seu valor vem do .bib.

TEMPLATE t21

SOURCE FIELDS
    REQUIRED description
    REQUIRED lattes_id ON BIBLIOGRAPHY
END SOURCE FIELDS

ITEM FIELDS
    REQUIRED citation
END ITEM FIELDS

FIELD description TYPE TEXT
    SCOPE SOURCE
END FIELD

FIELD lattes_id TYPE TEXT
    SCOPE SOURCE
    REFERS TO researcher
    DESCRIPTION ID Lattes de proveniencia (vem do .bib)
END FIELD

FIELD citation TYPE QUOTATION
    SCOPE ITEM
END FIELD
