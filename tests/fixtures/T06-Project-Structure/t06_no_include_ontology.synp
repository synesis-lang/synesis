#   Esperado: ERRO "O arquivo de projeto não possui um bloco INCLUDE ONTOLOGY".

PROJECT T06_No_Include_Ontology

    TEMPLATE "t06.synt"
    INCLUDE BIBLIOGRAPHY "t06.bib"
